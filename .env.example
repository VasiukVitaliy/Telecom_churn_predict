# Copy to `.env` and adjust. Relative paths are resolved against app_ml_rest_api/
# (never against the current working directory).

APP_ENV=development
RANDOM_STATE=42

# ---- MLflow: registry database + artifact storage --------------------------
# Relational backend for runs + model registry (SQLite by default, PostgreSQL in prod):
#   MLFLOW_TRACKING_URI=postgresql+psycopg2://user:password@db-host:5432/mlflow
MLFLOW_TRACKING_URI=sqlite:///models/mlflow.db
# Persistent artifact repository (serialized pipelines, plots, reference profiles)
MLFLOW_ARTIFACT_ROOT=./models/artifacts/
MLFLOW_EXPERIMENT_NAME=telecom-churn
REGISTERED_MODEL_NAME=TelecomChurnClassifier
CHAMPION_ALIAS=champion
CHALLENGER_ALIAS=challenger

# ---- Data paths -----------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_SYNTHETIC_DIR=data/synthetic
MODELS_DIR=models

# ---- Data quality gates ---------------------------------------------------
# Fraction (0-1). Any feature above this missing share is rejected.
MAX_MISSING_FRACTION=0.30
MIN_ROWS=200
MIN_MINORITY_SAMPLES=50
MAX_CATEGORICAL_CARDINALITY=50
# JSON list of regexes (case-insensitive); matching numeric columns must be >= 0
# (columns whose name contains change/trend/delta/diff/growth are exempt)
NON_NEGATIVE_PATTERNS=["tenure","charge","spend","minutes","sms","(^|_)gb(_|$)","calls","fee","amount","months","days","(^|_)age$","_count$"]

# ---- Preprocessing / training defaults -------------------------------------
NUMERIC_IMPUTATION=median          # median | mean | constant | iterative
CATEGORICAL_IMPUTATION=most_frequent  # most_frequent | constant
SAMPLING_STRATEGY=class_weight     # none | class_weight | random_over | smote
SAMPLING_RATIO=0.6
TEST_SIZE=0.2
CV_FOLDS=5
OPTUNA_STORAGE=sqlite:///models/optuna.db
OPTUNA_N_JOBS=1

# ---- Monitoring -------------------------------------------------------------
MONITOR_WINDOW_SIZE=5000
PSI_WARNING=0.10
PSI_ALERT=0.25

# ---- API / frontend ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8501"]
API_BASE_URL=http://localhost:8000
